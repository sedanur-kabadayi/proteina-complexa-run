""" 
First prepare the .pdb file -> ~/proteina-complexa/Proteina-Complexa/data

Prepare yout target config and add into configs/targets/targets_dict.yaml
"""

cat >> configs/targets/targets_dict.yaml << 'YAMLEOF'

  oc43_palmcore_ext_v2:
    target_input: "A461-928"
    target_path: "/home/seda/proteina-complexa/Proteina-Complexa/data/oc43_palmcore_ext.pdb"
    source: custom_targets
    target_filename: oc43_palmcore_ext
    hotspot_residues: ["A485","A487","A488","A490","A492","A493","A494","A495","A496","A570","A573","A574","A576","A577","A578","A579","A580","A603","A604","A678","A679","A681","A684"]
    binder_length: [80, 170]
    pdb_id: oc43
YAMLEOF

grep -A 8 "oc43_palmcore:" configs/targets/targets_dict.yaml

#validation before pilot run: 
#we don't need pilot run as we already optimized, but it is needed if you want to change the binder length, hotspot residues, target crop etc. just to confirm it is working

./run_env.sh complexa validate design configs/search_binder_local_pipeline.yaml


#pilot run:

./run_env.sh complexa design configs/search_binder_local_pipeline.yaml \
  ++run_name=oc43_palmcore_pilot \
  ++generation.task_name=oc43_palmcore \
  ++generation.dataloader.dataset.nres.nsamples=6 \
  ++generation.dataloader.batch_size=6 \
  ++generation.search.algorithm=beam-search \
  ++generation.search.beam_search.beam_width=4 \
  ++generation.search.beam_search.n_branch=4 \
  ++metric.binder_folding_method=colabdesign \
  ++metric.num_redesign_seqs=4


#after pilot run is over, evalaute the results with metrics:

python3 -c "
import pandas as pd, glob
files = glob.glob('evaluation_results/search_binder_local_pipeline_oc43_palmcore_ext_v2_oc43_palmcore_ext_v2_pilot/binder_results_*.csv')
df = pd.concat([pd.read_csv(f) for f in files])
print('N:', len(df))
print('pLDDT mean:', round(df['self_complex_pLDDT'].mean(),3))
print('min_ipAE mean:', round(df['self_complex_min_ipAE'].mean(),3))
"

#one of our addition to filtering is that: whether it is clashing rest of the RdRp protein or not (other than the cropped region):

./run_env.sh python oc43_v5_clashfilter.py \
  evaluation_results/search_binder_local_pipeline_oc43_palmcore_ext_v2_oc43_palmcore_ext_v2_pilot \
  "A461-928" 2>&1 | tail -3


#if passed, good to go with full batch run :)

./run_env.sh complexa design configs/search_binder_local_pipeline.yaml \
  ++run_name=oc43_palmcore_ext_v2_full \
  ++generation.task_name=oc43_palmcore_ext_v2 \
  ++generation.dataloader.dataset.nres.nsamples=15 \
  ++generation.dataloader.batch_size=2 \
  ++generation.search.algorithm=beam-search \
  ++generation.search.beam_search.beam_width=4 \
  ++generation.search.beam_search.n_branch=4 \
  ++gen_njobs=4 \
  ++eval_njobs=4 \
  ++seed=7
  ++metric.binder_folding_method=colabdesign \
  ++metric.num_redesign_seqs=4
